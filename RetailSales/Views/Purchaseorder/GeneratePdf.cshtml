@using DocumentFormat.OpenXml.Office2010.PowerPoint
@model RetailSales.Models.GeneratePdf

@{
    //Layout = "_PopupLayout";
    ViewData["Title"] = "Generate Pdf";
}
<style>
    .mandatory {
        color: red;
        position: relative;
        top: 2px;
        left: 5px;
    }

    .invoice {
        width: 210mm;
        margin: auto;
        background: #fff;
    }

    .container {
        width: 210mm;
    }

    .container {
        max-width: 210mm;
        margin: 0 auto;
        padding: 0;
    }

    .party-box {
        vertical-align: top;
        padding: 10px;
        font-size: 13px;
    }

    table {
        width: 100%;
        border-collapse: collapse !important;
    }

    table, th, td {
        border: 1px solid #000 !important;
    }

    th, td {
        padding: 6px 8px;
        font-size: 12px;
        vertical-align: middle;
    }

    thead th {
        background: #6c757d !important;
        color: #fff !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    /* Prevent broken borders */
    tr, td, th {
        page-break-inside: avoid !important;
    }
</style>
<script type="text/javascript">
    @if (TempData["notice"] != null)
    {
        @:alert('@TempData["notice"]');
    }
</script>

<div class="container">
    <div class="row">
        <div class="col-sm-12 text-left mt-3">
            <button class="btn btn-outline-success me-2" type="button" onclick="printInvoice()">Print</button>
            <button class="btn btn-outline-primary me-2" type="button" onclick="downloadPdf()">PDF</button>
            <button class="btn btn-outline-secondary me-" type="button" causesvalidation="false" onclick="location.href='@Url.Action("ListPurchaseorder", "Purchaseorder")'">Close</button>

            @* //<button class="btn btn-outline-secondary me-2" type="button" causesvalidation="false" onClick="window.parent.jQuery.fancybox.close();">Close</button> *@
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-body">
 <div class="invoice" id="invoice">
                        @using (Html.BeginForm("GeneratePdf", "Purchaseorder", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <div class="row align-items-center mb-3">
                                <div class="col-6 d-flex align-items-center">
            <img src="~/assets/images/logo/VAM.png" style="max-width:250px; height:auto;">
        </div>
       <div class="col-sm-6 d-flex justify-content-end">
           <div style="max-width: 250px;"></div>
    <div class="d-inline-block text-start">
        <p class="mb-1">
            <span class="fw-semibold">PO No:</span>
            <span>@Model.PoNo</span>
        </p>
        <p class="mb-0">
            <span class="fw-semibold">Date:</span>
            <span>@Model.PoDate:dd-MM-yyyy</span>
        </p>
    </div>
</div>
    </div>

                            <table class="w-100 mb-4">
                                <tr>
                                    <td class="party-box">
                                        <strong>V.A.M. Rathinam And Brothers</strong><br>
                                        35, Fort Main Road,<br>
                                        Salem – 636002<br>
                                        <strong>GSTIN:</strong> 33AACFV2120N1ZC
                                    </td>
                                    <td class="party-box">
                                        <strong>@Model.SuppName</strong><br>
                                        @Model.SuppAdd<br>
                                        <strong>GST:</strong> @Model.GSTNo
                                    </td>
                                </tr>
                            </table>

           <br />
           
       
    <div class="table-responsives">
        <table class="table table-bordered text-center align-middle">
            <thead class="table-light">
                <tr>
                    <th>S.no</th>
                    <th>Category</th>
                    <th>Product</th>
                    <th>Variant</th>
                    <th>Rate</th>
                    <th>Quantity</th>
                    <th>Total Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.GeneratePdfLst != null && Model.GeneratePdfLst.Any())
                {
                    int sl = 1;
                    foreach (var item in Model.GeneratePdfLst)
                    {
                        <tr>
                            <td>@sl</td>
                            <td>@item.Category</td>
                            <td>@item.Product</td>
                            <td>@item.Variant</td>
                            <td>@item.Rate</td>
                            <td>@item.Qty</td>
                            <td>@item.Total_Amount</td>
                            
                        </tr>
                        sl++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No items available
                        </td>
                    </tr>
                }
            </tbody>
        </table>
                            </div>
                            <hr />
                            <div class="row mt-5">
                                <div class="col-md-8">
                                    <p class="text-muted fst-italic">
                                        This is a system generated document. Signature not required.
                                    </p>
                                </div>
                                <div class="col-md-4 text-end">
                                    <p>
                                        For <strong>V.A.M. Rathinam & Bros.,</strong><br /><br />
                                        <strong>Authorized Signatory</strong>
                                    </p>
                                </div>
</div>


                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- PDF + Print Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
        

    async function downloadPdf() {
        const { jsPDF } = window.jspdf;
        const invoice = document.querySelector('.invoice');

        const canvas = await html2canvas(invoice, { scale: 2 });
        const imgData = canvas.toDataURL('image/png');

        const pdf = new jsPDF('p', 'mm', 'a4');
            const pageWidth = pdf.internal.pageSize.getWidth();
    const imgWidth = pageWidth;
        const pageHeight = 297;
        const imgHeight = (canvas.height * imgWidth) / canvas.width;

        let heightLeft = imgHeight;
        let position = 0;

        pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;

        while (heightLeft > 0) {
            position = heightLeft - imgHeight;
            pdf.addPage();
            pdf.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
            heightLeft -= pageHeight;
        }

        pdf.save("PurchaseOrder.pdf");
    }
</script>
<script>
        function printInvoice() {
     window.print();
    }
</script>